// Correct native PHPDoc only; no runtime override. Contracts verified in tags
// 20.0.0–24.0.0: selectarray iterates keyed options, multiselect accepts integer
// entity keys, pdf_getInstance forwards custom dimensions to TCPDF, and
// DolibarrModules::insert_module_parts accepts the structured hooks payload.
class Form
{
	/** @param array<int|string,string|int|array{label:string,data-html?:string,disable?:int,css?:string}> $array */
